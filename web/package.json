{
  "name": "zx-spectrum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The page: the screen, the sound, the keyboard, the tape deck, the library and the game in the machine, around the emulator compiled to WebAssembly.",
  "scripts": {
    "wasm": "bash ../scripts/build-wasm.sh",
    "dev": "bash ../scripts/build-wasm.sh && vite",
    "build": "bash ../scripts/build-wasm.sh && npm run build:page",
    "build:page": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:wasm": "vitest run -c vitest.wasm.config.ts",
    "test:page": "npx --yes tsx@4.20.6 tests/run.mjs page",
    "shot": "npx --yes tsx@4.20.6 tests/shot.mjs",
    "bench": "npx --yes tsx@4.20.6 tools/bench.mjs",
    "featured": "node tools/featured.mjs",
    "start": "cd .. && cargo run -q -p app -- web/dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "binaryen": "^132.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
